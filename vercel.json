{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/site.js": {
      "includeFiles": "private/**"
    },
    "api/erp.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/erp", "schedule": "0 4 * * *" }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/api/site?path=$1"
    }
  ]
}
