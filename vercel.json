<escape>{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/site.js": {
      "includeFiles": "private/**"
    }
  },
  "rewrites": [
    {
      "source": "/login.html",
      "destination": "/api/site?path=/login.html"
    },
    {
      "source": "/pandora-logo.png",
      "destination": "/api/site?path=/pandora-logo.png"
    },
    {
      "source": "/",
      "destination": "/api/site?path=/"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/site?path=$1"
    }
  ]
}</escape>
