{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/site.js": {
      "includeFiles": "private/**"
    },
    "api/erp.js": {
      "maxDuration": 60
    },
    "api/vm.js": {
      "includeFiles": "private/stockcount-pics-*.js"
    }
  },
  "crons": [
    {
      "path": "/api/erp",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/maintenance",
      "destination": "https://pandora-maintenance.vercel.app/maintenance"
    },
    {
      "source": "/maintenance/:path+",
      "destination": "https://pandora-maintenance.vercel.app/maintenance/:path+"
    },
    {
      "source": "/api/stock",
      "destination": "/api/erp?stock=1"
    },
    {
      "source": "/api/refill",
      "destination": "/api/erp?refill=1"
    },
    {
      "source": "/api/dist",
      "destination": "/api/erp?dist=1"
    },
    {
      "source": "/api/recv",
      "destination": "/api/erp?recv=1"
    },
    {
      "source": "/api/pic",
      "destination": "/api/erp?pic=1"
    },
    {
      "source": "/api/insights",
      "destination": "/api/erp?insights=1"
    },
    {
      "source": "/api/overview",
      "destination": "/api/erp?overview=1"
    },
    {
      "source": "/api/transfer",
      "destination": "/api/erp?transfer=1"
    },
    {
      "source": "/api/slow",
      "destination": "/api/erp?slow=1"
    },
    {
      "source": "/api/zonestock",
      "destination": "/api/vm?zonestock=1"
    },
    {
      "source": "/api/checker",
      "destination": "/api/vm?checker=1"
    },
    {
      "source": "/api/checkerpair",
      "destination": "/api/vm?checkerpair=1"
    },
    {
      "source": "/api/stockcount",
      "destination": "/api/vm?stockcount=1"
    },
    {
      "source": "/api/daily",
      "destination": "/api/vm?daily=1"
    },
    {
      "source": "/api/schedule",
      "destination": "/api/vm?schedule=1"
    },
    {
      "source": "/api/vmzones",
      "destination": "/api/vm?vmzones=1"
    },
    {
      "source": "/api/access",
      "destination": "/api/vm?access=1"
    },
    {
      "source": "/api/activity",
      "destination": "/api/vm?activity=1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/site?path=$1"
    }
  ]
}
