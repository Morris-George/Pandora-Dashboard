{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/site.js": {
      "includeFiles": "private/**"
    },
    "api/erp.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/erp",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/stock",
      "destination": "/api/erp?stock=1"
    },
    {
      "source": "/api/refill",
      "destination": "/api/erp?refill=1"
    },
    {
      "source": "/api/dist",
      "destination": "/api/erp?dist=1"
    },
    {
      "source": "/api/slow",
      "destination": "/api/erp?slow=1"
    },
    {
      "source": "/api/zonestock",
      "destination": "/api/vm?zonestock=1"
    },
    {
      "source": "/api/stockcount",
      "destination": "/api/vm?stockcount=1"
    },
    {
      "source": "/api/daily",
      "destination": "/api/vm?daily=1"
    },
    {
      "source": "/api/schedule",
      "destination": "/api/vm?schedule=1"
    },
    {
      "source": "/api/vmzones",
      "destination": "/api/vm?vmzones=1"
    },
    {
      "source": "/api/access",
      "destination": "/api/vm?access=1"
    },
    {
      "source": "/api/activity",
      "destination": "/api/vm?activity=1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/site?path=$1"
    }
  ]
}
